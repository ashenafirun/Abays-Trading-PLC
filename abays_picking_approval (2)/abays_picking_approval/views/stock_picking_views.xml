<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_picking_approval_inherit" model="ir.ui.view">
            <field name="name">stock.picking.approval.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">

                <!-- APPROVAL BUTTONS before first Validate -->
                <xpath expr="//button[@name='button_validate'][1]" position="before">
                    <button name="action_inspect" string="Inspect" type="object" class="btn-primary" icon="fa-search"
                        invisible="not x_show_approval or x_approval_state != 'draft' or state in ('done', 'cancel')"
                        groups="abays_picking_approval.group_picking_inspector"/>
                    <button name="action_receive_approval" string="Receive" type="object" class="btn-primary" icon="fa-inbox"
                        invisible="not x_show_approval or x_approval_state != 'inspected' or state in ('done', 'cancel')"
                        groups="abays_picking_approval.group_picking_receiver"/>
                    <button name="action_audit" string="Audit" type="object" class="btn-primary" icon="fa-file-text"
                        invisible="not x_show_approval or x_approval_state != 'received' or state in ('done', 'cancel')"
                        groups="abays_picking_approval.group_picking_auditor"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" icon="fa-check-circle"
                        invisible="not x_show_approval or x_approval_state != 'audited' or state in ('done', 'cancel')"
                        groups="abays_picking_approval.group_picking_approver"/>
                </xpath>

                <!-- Hide BOTH Validate buttons until fully approved for GRN -->
                <xpath expr="//button[@name='button_validate'][1]" position="attributes">
                    <attribute name="invisible">state in ('done', 'cancel', 'draft', 'confirmed') or (x_show_approval and x_approval_state != 'approved')</attribute>
                </xpath>
                <xpath expr="//button[@name='button_validate'][2]" position="attributes">
                    <attribute name="invisible">state in ('done', 'cancel', 'assigned') or (x_show_approval and x_approval_state != 'approved')</attribute>
                </xpath>

                <!-- Approval status banner showing EMPLOYEE NAMES -->
                <xpath expr="//field[@name='state'][@widget='statusbar'][1]" position="after">
                    <div invisible="not x_show_approval" class="d-flex align-items-center gap-2 px-3 py-2 bg-light border-bottom">
                        <span class="fw-bold text-muted small me-2">Approval Status:</span>

                        <span invisible="not x_inspected_name" class="badge text-bg-success">
                            <i class="fa fa-check me-1"/>Inspected: <field name="x_inspected_name" readonly="1" nolabel="1"/>
                        </span>
                        <span invisible="x_inspected_name" class="badge text-bg-secondary">Pending Inspection</span>

                        <i class="fa fa-chevron-right text-muted"/>

                        <span invisible="not x_received_name" class="badge text-bg-success">
                            <i class="fa fa-check me-1"/>Received: <field name="x_received_name" readonly="1" nolabel="1"/>
                        </span>
                        <span invisible="x_received_name" class="badge text-bg-secondary">Pending Receive</span>

                        <i class="fa fa-chevron-right text-muted"/>

                        <span invisible="not x_audited_name" class="badge text-bg-success">
                            <i class="fa fa-check me-1"/>Audited: <field name="x_audited_name" readonly="1" nolabel="1"/>
                        </span>
                        <span invisible="x_audited_name" class="badge text-bg-secondary">Pending Audit</span>

                        <i class="fa fa-chevron-right text-muted"/>

                        <span invisible="not x_approved_name" class="badge text-bg-success">
                            <i class="fa fa-check me-1"/>Approved: <field name="x_approved_name" readonly="1" nolabel="1"/>
                        </span>
                        <span invisible="x_approved_name" class="badge text-bg-secondary">Pending Approval</span>
                    </div>
                </xpath>

                <!-- Approval Details tab -->
                <xpath expr="//notebook" position="inside">
                    <page string="Approval Details" invisible="not x_show_approval">
                        <group>
                            <group string="Step 1 - Inspection">
                                <field name="x_inspected_name" readonly="1"/>
                                <field name="x_inspected_date" readonly="1"/>
                            </group>
                            <group string="Step 2 - Receive">
                                <field name="x_received_name" readonly="1"/>
                                <field name="x_received_date" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Step 3 - Audit">
                                <field name="x_audited_name" readonly="1"/>
                                <field name="x_audited_date" readonly="1"/>
                            </group>
                            <group string="Step 4 - Final Approval">
                                <field name="x_approved_name" readonly="1"/>
                                <field name="x_approved_date" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
