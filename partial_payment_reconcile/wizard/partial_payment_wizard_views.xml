<odoo>

    <record id="view_partial_payment_wizard_form" model="ir.ui.view">
        <field name="name">partial.payment.wizard.form</field>
        <field name="model">partial.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Partial Payment">
                <group>
                    <group>
                        <field name="company_currency_id" invisible="1"/>
                        <field name="available_line_ids" invisible="1"/>
                        <field name="move_id" invisible="1"/>
                        <field name="invoice_line_id" invisible="1"/>
                        <field name="invoice_residual" readonly="1"/>
                        <field name="counterpart_line_id" required="1"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="counterpart_available" readonly="1"/>
                    </group>
                    <group>
                        <field name="amount"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
