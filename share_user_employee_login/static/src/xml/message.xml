<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="moving_chatter_records.Message" t-inherit="mail.Message" t-inherit-mode="extension" owl="1">

        <xpath expr="//img[@t-att-src='authorAvatarUrl']" position="replace">
            <img t-if="message.employee_name" class="o-mail-Message-avatar w-100 h-100 rounded-3" t-att-src="message.employee_avatar" t-att-class="authorAvatarAttClass"/>
            <img t-else="" class="o-mail-Message-avatar w-100 h-100 rounded-3" t-att-src="authorAvatarUrl" t-att-class="authorAvatarAttClass"/>
        </xpath>

        <xpath expr="//strong[@t-esc='authorName']" position="replace">
            <strong t-if="message.employee_name" class="me-1 o-fw-600" t-esc="message.employee_name"/>
            <strong t-else="" class="me-1 o-fw-600" t-esc="authorName"/>
        </xpath>

    </t>


</templates>
