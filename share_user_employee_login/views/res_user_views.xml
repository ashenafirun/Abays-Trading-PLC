<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="view_totp_form">
        <field name="name">share_user_form_view</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='preferences']" position="inside">
                <field name="share_account_enabled" groups="share_user_employee_login.allow_share_internal_user_group" invisible="share"/>
                <field name="shared_employee_ids" widget="many2many_avatar_employee" options="{'display_avatar_name': true}" invisible="not share_account_enabled or share"
                groups="share_user_employee_login.allow_share_internal_user_group"/>
            </xpath>
        </field>
    </record>
</odoo>

