<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="view_mail_tree_employee">
        <field name="name">mail.mail.list.employee</field>
        <field name="model">mail.mail</field>
        <field name="inherit_id" ref="mail.view_mail_tree"/>
        <field name="arch" type="xml">
            <field name="author_id" position="after">
                <field name="employee_id" widget="many2one_avatar_employee" options="{'display_avatar_name': true}" string="Sent Employee"/>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="view_mail_form_employee">
        <field name="name">mail.mail.form.employee</field>
        <field name="model">mail.mail</field>
        <field name="inherit_id" ref="mail.view_mail_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='author_id']" position="replace">
                <field name="employee_id" class="oe_inline" string="Employee" invisible="not employee_id"/>
                <field name="author_id" class="oe_inline" string="User" invisible="employee_id"/>
            </xpath>
        </field>
    </record>
</odoo>

