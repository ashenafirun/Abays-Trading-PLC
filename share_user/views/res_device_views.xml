<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_device_view_kanban_employee" model="ir.ui.view">
        <field name="name">res.device.view.kanban.employee</field>
        <field name="model">res.device</field>
        <field name="inherit_id" ref="base.res_device_view_kanban"/>
        <field name="arch" type="xml">
            <field name="ip_address" position="after">
                <field name="employee_id" widget="many2one_avatar_employee" options="{'display_avatar_name': true}" invisible="not employee_id"/>
            </field>
        </field>
    </record>
</odoo>

