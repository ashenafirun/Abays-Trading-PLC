<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="report_grn_custom" model="ir.ui.view">
            <field name="name">stock.report_delivery_document_copy_1</field>
            <field name="key">stock.report_delivery_document_copy_1</field>
            <field name="type">qweb</field>
            <field name="arch" type="xml">
<t t-name="stock.report_delivery_document_copy_1">
  <t t-call="web.html_container">
    <t t-foreach="docs" t-as="o">
      <div class="page" style="font-family: Arial, sans-serif; font-size: 11px; padding: 10px;">

        <table style="width:100%; border-collapse:collapse; border:1.5px solid black;" cellpadding="4">
          <tr>
            <td rowspan="3" style="width:120px; border-right:1.5px solid black; text-align:center; vertical-align:middle;">
              <t t-if="o.company_id.logo">
                <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height:70px; max-width:100px;"/>
              </t>
            </td>
            <td style="text-align:center; border-bottom:1px solid black; border-right:1.5px solid black;">
              <img src="data:image/png;base64," style="height:22px;" alt="amharic"/>
            </td>
            <td style="border-bottom:1px solid black; border-right:1px solid black; padding:3px 6px;">Doc. No.<br/><strong>OF/CD/048</strong></td>
            <td style="border-bottom:1px solid black; padding:3px 6px;">Issue Date<br/><strong>July 2023</strong></td>
          </tr>
          <tr>
            <td style="text-align:center; font-size:12px; font-weight:bold; border-bottom:1px solid black; border-right:1.5px solid black;">Company Name:- ABAYS TRADING PLC</td>
            <td style="border-bottom:1px solid black; border-right:1px solid black; padding:3px 6px;">Issue No. 1</td>
            <td style="border-bottom:1px solid black; padding:3px 6px;">Page 1 of 1</td>
          </tr>
          <tr>
            <td style="text-align:center; border-right:1.5px solid black; padding:3px;">Title:-   <strong>Goods Receiving Note</strong></td>
            <td colspan="2"/>
          </tr>
        </table>

        <table style="width:100%; margin-top:8px;" cellpadding="3">
          <tr>
            <td style="width:50%;">Date: <u><t t-esc="o.scheduled_date and o.scheduled_date.strftime('%d-%m-%Y') or ''"/></u></td>
            <td style="text-align:right;">No.   <strong><span t-field="o.name"/></strong></td>
          </tr>
        </table>

        <!-- Store Req No = SR.NO from approval request (stored on GRN as x_store_req_no) -->
        <!-- Purchase Req No = APPR number (stored on GRN as x_purchase_req_no) -->
        <table style="width:100%; margin-top:6px; border-collapse:collapse;" cellpadding="3">
          <tr>
            <td style="width:40%;">Name of Supplier :- <u><span t-field="o.partner_id.name"/></u></td>
            <td style="width:30%;">Store Req. No <u>
              <t t-if="o.x_store_req_no"><t t-esc="o.x_store_req_no"/></t>
            </u></td>
            <td style="width:30%;">Purchase Req. No. <u>
              <t t-if="o.x_purchase_req_no"><t t-esc="o.x_purchase_req_no"/></t>
            </u></td>
          </tr>
          <tr>
            <td>Supplier Invoice No.:- <u>                   </u></td>
            <td>Supplier Address:- <u>                   </u></td>
            <td>Purchase Type:- Foreign <u>    </u> Local <u>    </u></td>
          </tr>
        </table>

        <table style="width:100%; margin-top:8px; border-collapse:collapse; border:1.5px solid black;" cellpadding="4">
          <thead>
            <tr style="background-color:#f0f0f0; font-weight:bold; text-align:center;">
              <th style="border:1px solid black; width:5%;">S.No.</th>
              <th style="border:1px solid black; width:12%;">Item Code</th>
              <th style="border:1px solid black; width:30%;">Item Description</th>
              <th style="border:1px solid black; width:8%;">UOM</th>
              <th style="border:1px solid black; width:10%;">Qty.</th>
              <th style="border:1px solid black; width:12%;">Unit Price</th>
              <th style="border:1px solid black; width:12%;">Total Price</th>
              <th style="border:1px solid black; width:11%;">Remark</th>
            </tr>
          </thead>
          <tbody>
            <t t-set="line_num" t-value="0"/>
            <t t-foreach="o.move_ids.filtered(lambda m: m.product_uom_qty)" t-as="move">
              <t t-set="line_num" t-value="line_num + 1"/>
              <tr>
                <td style="border:1px solid black; text-align:center;"><t t-esc="line_num"/></td>
                <td style="border:1px solid black; text-align:center;"><span t-field="move.product_id.default_code"/></td>
                <td style="border:1px solid black;"><span t-field="move.product_id.display_name"/></td>
                <td style="border:1px solid black; text-align:center;"><span t-field="move.product_uom"/></td>
                <td style="border:1px solid black; text-align:center;"><span t-field="move.quantity"/></td>
                <td style="border:1px solid black;"/>
                <td style="border:1px solid black;"/>
                <td style="border:1px solid black;"/>
              </tr>
            </t>
            <t t-set="filled" t-value="len(o.move_ids.filtered(lambda m: m.product_uom_qty))"/>
            <t t-foreach="range(max(0, 8 - filled))" t-as="empty">
              <tr style="height:24px;">
                <td style="border:1px solid black;"/>
                <td style="border:1px solid black;"/>
                <td style="border:1px solid black;"/>
                <td style="border:1px solid black;"/>
                <td style="border:1px solid black;"/>
                <td style="border:1px solid black;"/>
                <td style="border:1px solid black;"/>
                <td style="border:1px solid black;"/>
              </tr>
            </t>
            <tr style="font-weight:bold;">
              <td colspan="6" style="border:1px solid black; text-align:center;">Total</td>
              <td style="border:1px solid black;"/>
              <td style="border:1px solid black;"/>
            </tr>
          </tbody>
        </table>

        <!-- All 4 signature boxes use scheduled_date as date -->
        <t t-set="sig_date" t-value="o.scheduled_date and o.scheduled_date.strftime('%d-%m-%Y') or ''"/>

        <table style="width:100%; margin-top:16px; border-collapse:collapse;" cellpadding="0">
          <tr style="vertical-align:top;">

            <td style="width:25%; border:1px solid black; padding:5px 6px;">
              <div style="font-weight:bold; margin-bottom:3px;">Inspected by</div>
              <div style="font-size:9px; color:#666;">Name</div>
              <div style="border-bottom:1px solid black; min-height:15px; margin-bottom:4px; padding:1px 0;">
                <t t-if="o.x_inspected_name"><span style="font-size:10px;"><t t-esc="o.x_inspected_name"/></span></t>
              </div>
              <div style="font-size:9px; color:#666;">Signature</div>
              <div style="border-bottom:1px solid black; height:40px; margin-bottom:4px; overflow:hidden;">
                <t t-if="o.x_inspected_signature">
                  <img t-att-src="image_data_uri(o.x_inspected_signature)" style="height:38px; max-width:118px; display:block; mix-blend-mode:multiply;"/>
                </t>
              </div>
              <div style="font-size:9px; color:#666;">Date</div>
              <div style="border-bottom:1px solid black; min-height:15px; padding:1px 0;">
                <span style="font-size:10px;"><t t-esc="sig_date"/></span>
              </div>
            </td>

            <td style="width:25%; border:1px solid black; padding:5px 6px;">
              <div style="font-weight:bold; margin-bottom:3px;">Received by</div>
              <div style="font-size:9px; color:#666;">Name</div>
              <div style="border-bottom:1px solid black; min-height:15px; margin-bottom:4px; padding:1px 0;">
                <t t-if="o.x_received_name"><span style="font-size:10px;"><t t-esc="o.x_received_name"/></span></t>
              </div>
              <div style="font-size:9px; color:#666;">Signature</div>
              <div style="border-bottom:1px solid black; height:40px; margin-bottom:4px; overflow:hidden;">
                <t t-if="o.x_received_signature">
                  <img t-att-src="image_data_uri(o.x_received_signature)" style="height:38px; max-width:118px; display:block; mix-blend-mode:multiply;"/>
                </t>
              </div>
              <div style="font-size:9px; color:#666;">Date</div>
              <div style="border-bottom:1px solid black; min-height:15px; padding:1px 0;">
                <span style="font-size:10px;"><t t-esc="sig_date"/></span>
              </div>
            </td>

            <td style="width:25%; border:1px solid black; padding:5px 6px;">
              <div style="font-weight:bold; margin-bottom:3px;">Audit by</div>
              <div style="font-size:9px; color:#666;">Name</div>
              <div style="border-bottom:1px solid black; min-height:15px; margin-bottom:4px; padding:1px 0;">
                <t t-if="o.x_audited_name"><span style="font-size:10px;"><t t-esc="o.x_audited_name"/></span></t>
              </div>
              <div style="font-size:9px; color:#666;">Signature</div>
              <div style="border-bottom:1px solid black; height:40px; margin-bottom:4px; overflow:hidden;">
                <t t-if="o.x_audited_signature">
                  <img t-att-src="image_data_uri(o.x_audited_signature)" style="height:38px; max-width:118px; display:block; mix-blend-mode:multiply;"/>
                </t>
              </div>
              <div style="font-size:9px; color:#666;">Date</div>
              <div style="border-bottom:1px solid black; min-height:15px; padding:1px 0;">
                <span style="font-size:10px;"><t t-esc="sig_date"/></span>
              </div>
            </td>

            <td style="width:25%; border:1px solid black; padding:5px 6px;">
              <div style="font-weight:bold; margin-bottom:3px;">Approved by</div>
              <div style="font-size:9px; color:#666;">Name</div>
              <div style="border-bottom:1px solid black; min-height:15px; margin-bottom:4px; padding:1px 0;">
                <t t-if="o.x_approved_name"><span style="font-size:10px;"><t t-esc="o.x_approved_name"/></span></t>
              </div>
              <div style="font-size:9px; color:#666;">Signature</div>
              <div style="border-bottom:1px solid black; height:40px; margin-bottom:4px; overflow:hidden;">
                <t t-if="o.x_approved_signature">
                  <img t-att-src="image_data_uri(o.x_approved_signature)" style="height:38px; max-width:118px; display:block; mix-blend-mode:multiply;"/>
                </t>
              </div>
              <div style="font-size:9px; color:#666;">Date</div>
              <div style="border-bottom:1px solid black; min-height:15px; padding:1px 0;">
                <span style="font-size:10px;"><t t-esc="sig_date"/></span>
              </div>
            </td>

          </tr>
        </table>

        <p style="margin-top:8px; font-size:10px;">
          Distribution:- Original:- Accountant    1<sup>st</sup> copy:- Cost    2<sup>nd</sup> copy:- Store    3<sup>rd</sup> copy:- pad
        </p>

        <table style="width:100%; border-top:1.5px solid black; margin-top:4px;" cellpadding="3">
          <tr style="text-align:center;">
            <td style="width:33%; border-right:1px solid black;">Prepared by CD</td>
            <td style="width:33%; border-right:1px solid black;">Reviewed by FSTL</td>
            <td style="width:33%;">Approved by GM</td>
          </tr>
        </table>

      </div>
    </t>
  </t>
</t>
            </field>
        </record>
    </data>
</odoo>
